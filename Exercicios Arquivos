            pwRelatorio.println("----------------------------------------"); 
            pwRelatorio.printf("Total de alunos    : %d\n", turma.size()); 
            pwRelatorio.printf("Aprovados          : %d\n", aprovados); 
            pwRelatorio.printf("Em recuperação     : %d\n", recuperacao); 
            pwRelatorio.printf("Reprovados         : %d\n", reprovados); 
            pwRelatorio.printf("Média geral        : %.2f\n", mediaGeral); 
            pwRelatorio.printf("Maior média        : %.2f (%s)\n", maiorMedia.media, maiorMedia.nome); 
            pwRelatorio.printf("Menor média        : %.2f (%s)\n", menorMedia.media, menorMedia.nome); 
