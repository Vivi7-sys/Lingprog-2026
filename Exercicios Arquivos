    // Criando uma classe interna auxiliar para mapear a estrutura do aluno de forma limpa
    private static class Aluno {
        String nome;
        double n1, n2, n3, media;
        String situacao;

        public Aluno(String nome, double n1, double n2, double n3) {
            this.nome = nome;
            this.n1 = n1;
            this.n2 = n2;
            this.n3 = n3;
            this.media = (n1 + n2 + n3) / 3.0; 
            
            if (this.media >= 7.0) this.situacao = "Aprovado"; 
            else if (this.media >= 5.0) this.situacao = "Recuperação"; 
            else this.situacao = "Reprovado"; 
        }
    }

