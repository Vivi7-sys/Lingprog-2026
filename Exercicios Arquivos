                    double n1 = Double.parseDouble(partes[1].trim());
                    double n2 = Double.parseDouble(partes[2].trim());
                    double n3 = Double.parseDouble(partes[3].trim());
                    turma.add(new Aluno(nome, n1, n2, n3)); 
