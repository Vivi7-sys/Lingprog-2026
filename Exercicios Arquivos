    private static void gerarRelatorio() { 
        // Listas auxiliares para armazenar os dados lidos antes do cálculo da média geral
        ArrayList<String> nomes = new ArrayList<>();
        ArrayList<Double> notas = new ArrayList<>();
        double somaNotas = 0;

        try (BufferedReader reader = new BufferedReader(new FileReader("notas.txt"))) { 
            String linha;
            while ((linha = reader.readLine()) != null) { 
                String[] partes = linha.split(","); 
                if (partes.length == 2) {
                    String nome = partes[0].trim();
                    double nota = Double.parseDouble(partes[1].trim());
                    nomes.add(nome); 
                    notas.add(nota);
                    somaNotas += nota;
                }
            }
        } catch (IOException e) {
            System.out.println("Erro ao ler notas para o relatório: " + e.getMessage());
            return;
        }

        if (nomes.isEmpty()) return;

        double mediaTurma = somaNotas / nomes.size();

        // Escrevendo o relatório formatado
        try (PrintWriter writer = new PrintWriter(new FileWriter("relatorio.txt"))) { 
            writer.println("=== Relatório de Notas ==="); 
            writer.println();
            writer.printf("%-15s%-7s%s\n", "Nome", "Nota", "Situação"); 

            for (int i = 0; i < nomes.size(); i++) {
                String nome = nomes.get(i);
                double nota = notas.get(i);
                String situacao = (nota >= 6.0) ? "Aprovado" : "Reprovado"; 
                writer.printf("%-15s%-7.1f%s\n", nome, nota, situacao);
            }

            writer.println();
            writer.printf("Média da turma: %.1f\n", mediaTurma); 
            System.out.println("Relatório 'relatorio.txt' gerado com sucesso!");
        } catch (IOException e) {
            System.out.println("Erro ao gerar arquivo de relatório: " + e.getMessage());
        }
    }

