    private static void inserirContato(Scanner sc) { 
        int proximoId = 1; 
        File arquivo = new File("agenda.csv"); 

        // Descobre o maior ID para autoincremento
        if (arquivo.exists()) {
            try (BufferedReader br = new BufferedReader(new FileReader(arquivo))) {
                String linha;
                int maiorId = 0; 
                while ((linha = br.readLine()) != null) { 
                    String[] dados = linha.split(","); 
                    if (dados.length > 0) {
                        int idAtual = Integer.parseInt(dados[0]);
                        if (idAtual > maiorId) { 
                            maiorId = idAtual;
                        }
                    }
                }
                proximoId = maiorId + 1; 
            } catch (IOException | NumberFormatException e) {
                System.out.println("Erro ao calcular ID: " + e.getMessage());
            }
        }

        System.out.print("Nome: ");
        String nome = sc.nextLine();
        System.out.print("Telefone: ");
        String telefone = sc.nextLine();
        System.out.print("Email: ");
        String email = sc.nextLine();

        // Salva concatenando usando Append
        try (PrintWriter pw = new PrintWriter(new FileWriter(arquivo, true))) { 
            pw.printf("%d,%s,%s,%s\n", proximoId, nome, telefone, email); 
            System.out.println("Contato inserido com sucesso!");
        } catch (IOException e) {
            System.out.println("Erro ao salvar contato: " + e.getMessage());
        }
    }

    private static void buscarPorNome(Scanner sc) { 
        System.out.print("Digite o nome ou parte dele para buscar: ");
        String busca = sc.nextLine().trim();

        try (BufferedReader br = new BufferedReader(new FileReader("agenda.csv"))) { 
            String linha;
            boolean encontrado = false;
            while ((linha = br.readLine()) != null) { 
                String[] dados = linha.split(","); 
                // Ignora Case e valida se o nome contém o termo buscado
                if (dados.length == 4 && dados[1].toLowerCase().contains(busca.toLowerCase())) { 
                    System.out.printf("ID: %s | Nome: %s | Tel: %s | Email: %s\n", dados[0], dados[1], dados[2], dados[3]);
                    encontrado = true;
                }
            }
            if (!encontrado) System.out.println("Nenhum contato localizado.");
        } catch (FileNotFoundException e) {
            System.out.println("Agenda vazia.");
        } catch (IOException e) {
            System.out.println("Erro ao buscar: " + e.getMessage());
        }
    }

    private static void removerPorId(Scanner sc) { 
        System.out.print("Digite o ID do contato para remover: ");
        String idParaRemover = sc.nextLine().trim();

        File arquivo = new File("agenda.csv"); 
        if (!arquivo.exists()) return;

        ArrayList<String> linhasManter = new ArrayList<>(); 
        boolean excluido = false;

        // Passada 1: Lê tudo para a memória filtrando o ID
        try (BufferedReader br = new BufferedReader(new FileReader(arquivo))) {
            String linha;
            while ((linha = br.readLine()) != null) { [cite: 74]
                String[] dados = linha.split(","); [cite: 64]
                if (dados.length > 0 && dados[0].trim().equals(idParaRemover)) { 
                    excluido = true; // Ignora a linha (remove) 
                } else {
                    linhasManter.add(linha);
                }
            }
        } catch (IOException e) {
            System.out.println("Erro ao processar remoção: " + e.getMessage());
            return;
        }

        // Passada 2: Sobrescreve sem append com o vetor filtrado
        try (PrintWriter pw = new PrintWriter(new FileWriter(arquivo, false))) { 
            for (String l : linhasManter) {
                pw.println(l); 
            }
            if (excluido) {
                System.out.println("Contato removido com sucesso!");
            } else {
                System.out.println("ID não encontrado.");
            }
        } catch (IOException e) {
            System.out.println("Erro ao atualizar arquivo após remoção: " + e.getMessage());
        }
    }

