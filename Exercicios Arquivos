                } else if (a.situacao.equals("Recuperação")) { 
                    recuperacao++; [cite: 97]
                } else {
                    reprovados++; [cite: 97]
                }

                // Maior/Menor Nota
                if (a.media > maiorMedia.media) maiorMedia = a; 
                if (a.media < menorMedia.media) menorMedia = a; 
            }
        } catch (IOException e) {
            System.out.println("Erro ao gerar aprovados.csv: " + e.getMessage());
        }

        double mediaGeral = somaGeral / turma.size(); 

        // 3. Gravando o arquivo relatorio_final.txt formatado
        try (PrintWriter pwRelatorio = new PrintWriter(new FileWriter("relatorio_final.txt"))) { 
